# Host startup: source this file before `go run ./cmd/api`.
DATABASE_URL=postgres://bookstore:bookstore@localhost:5433/bookstore?sslmode=disable
REDIS_ADDR=localhost:6380
HTTP_ADDR=:8080

# Values for later cache exercises. The starter routes bypass Redis.
CACHE_TTL=30s
LOCAL_CACHE_TTL=5s
LOCAL_CACHE_MAX_ENTRIES=100
HOT_KEY_REPLICAS=3
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=10s
